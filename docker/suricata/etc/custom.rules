# 1. ICMP Ping Sweep
alert icmp any any -> any any (msg:"UniSec-Edge: ICMP Ping Sweep Detected"; itype:8; threshold:type both, track by_src, count 5, seconds 10; classtype:attempted-recon; sid:1000001; rev:2;)

# 2. TCP Port Scan
alert tcp any any -> any any (msg:"UniSec-Edge: TCP Port Scan Detected"; flags:S; threshold:type threshold, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000002; rev:1;)

# 3. SSH Brute Force on Honeypot
alert tcp any any -> any 2222 (msg:"UniSec-Edge: SSH Brute Force on Honeypot"; flow:to_server; flags:S; threshold:type limit, track by_src, count 3, seconds 60; classtype:attempted-login; sid:1000003; rev:2;)

# 4. ICMP Flood DoS
alert icmp any any -> any any (msg:"UniSec-Edge: ICMP Flood Detected"; itype:8; threshold:type both, track by_src, count 100, seconds 5; classtype:attempted-dos; sid:1000009; rev:1;)

# 5. TCP SYN Flood
alert tcp any any -> any any (msg:"UniSec-Edge: TCP SYN Flood Detected"; flags:S; threshold:type both, track by_src, count 200, seconds 10; classtype:attempted-dos; sid:1000010; rev:1;)
